# ===== Banco de dados (Supabase PostgreSQL gerenciado) =====
# Substitua pela connection string do Supabase (conexão direta ou pooler com SSL)
DATABASE_URL="postgresql://postgres:SUA_SENHA@db.xxxx.supabase.co:5432/postgres?sslmode=require"

# ===== Segurança / JWT =====
JWT_SECRET="TROQUE_POR_UM_SEGREDO_ALEATORIO_FORTE"
JWT_EXPIRES_IN="7d"

# ===== Servidor =====
PORT=3000
NODE_ENV="production"

# ===== CORS =====
# Em produção, front e API na mesma origem (/api), pode manter apenas o domínio.
CORS_ORIGIN="https://olagestorpb.com.br"

# ===== Conta do Super Admin (usada pelo seed) =====
ADMIN_EMAIL="admin@olagestorpb.com.br"
ADMIN_PASSWORD="TROQUE_A_SENHA_DO_SUPER_ADMIN"

# ===== App =====
APP_URL="https://olagestorpb.com.br"